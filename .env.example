# Traduit depuis le russe par Ayoub Lemsoudi.
# Copy to .env and fill in. NEVER commit the real .env.
# Get a fresh token from @BotFather (/newbot or /revoke).
BOT_TOKEN=put-your-fresh-botfather-token-here
BOT_USERNAME=your_bot_username

# Database
DB_NAME=vinted
DB_URL=jdbc:postgresql://localhost:5432/vinted
DB_USER=vinted
DB_PASSWORD=change-me

# Optional HTTP/SOCKS proxy for scaling, e.g. http://user:pass@host:port
VINTED_PROXY=

# Surveillance des recherches — configuration ajoutée par Ayoub Lemsoudi.
MONITOR_ENABLED=true
MONITOR_INTERVAL_MS=60000
MONITOR_BACKOFF_MS=900000

# Le navigateur Chrome est facultatif pour le mode de secours des pages HTML.
SELENIUM_ENABLED=false
CHROME_BINARY_PATH=
CHROME_DRIVER_PATH=
IMAGE_CACHE_DIR=/tmp/vinted_images
